FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci && npm cache clean --force

COPY db.json /app/db.seed.json

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/veiculos > /dev/null || exit 1

CMD ["sh", "-c", "if [ ! -s /data/db.json ]; then cp /app/db.seed.json /data/db.json; fi; exec ./node_modules/.bin/json-server --watch /data/db.json --port 3000 --host 0.0.0.0"]
